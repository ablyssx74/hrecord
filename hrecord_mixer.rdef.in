resource app_signature "application/x-vnd.hrecord-mixer";

resource app_version {
    major  = 1,
    minor  = 14,
    middle = 2,
    variety = B_APPV_DEVELOPMENT,
    internal = 0,
    short_info = "hRecord Mixer v1.14.2",
    long_info = "A mixer window for hrecord: levels, volume, balance, mute, solo and a limiter"
};

resource app_flags B_SINGLE_LAUNCH;

resource vector_icon {
@ICON@
};
